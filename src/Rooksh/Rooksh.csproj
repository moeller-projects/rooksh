<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Rooksh</RootNamespace>
    <AssemblyName>rooksh</AssemblyName>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rooksh.Chess\Rooksh.Chess.csproj" />
    <ProjectReference Include="..\Rooksh.Match\Rooksh.Match.csproj" />
    <ProjectReference Include="..\Rooksh.Rendering\Rooksh.Rendering.csproj" />
    <ProjectReference Include="..\Rooksh.Uci\Rooksh.Uci.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LukasMoeller.Configuration.Toml" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
  </ItemGroup>

  <ItemGroup>
    <None Update="rooksh.toml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
